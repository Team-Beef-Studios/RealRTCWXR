weaponDef
{
	client {
		//standModel	     ""
		pickupModel		     "models/weapons/pistols/tt33/tt33_3rd.md3"
		droppedAnglesHack
		
		weaponConfig		"models/weapons/pistols/tt33/weapon.cfg"
		handsModel			"models/weapons/pistols/tt33/v_tt33_hand.md3"
		
		flashDlightColor	1.0 0.6 0.23
		flashSound			"sound/weapons/tt33/tt33_fire.wav"		
		flashEchoSound		"sound/weapons/tt33/tt33_far.wav"		
		//lastShotSound		""										
		
		//readySound		""
		//firingSound		""									
		//overheatSound		""
		reloadSound			"sound/weapons/tt33/tt33_reload.wav"
		reloadFullSound		"sound/weapons/tt33/tt33_reload.wav"
		reloadSoundAi	    "sound/weapons/ai/pistol_reload.wav"
		//reloadFastSound	""		
		//spinupSound		""									
		//spindownSound		""									
		//switchSound		""	
        bounceSound         "sound/misc/weapon_bounce.wav"	
		
		weaponIcon			"icons/iconw_tt33"
		weaponSelectedIcon	"icons/iconw_tt33_select"
		
		//missileModel		""
		//missileSound		""
		//missileTrailFunc	""									// supports "GrenadeTrail", "RocketTrail", "PyroSmokeTrail"
		//missileDlight		0
		//missileDlightColor	0 0 0							
		
		weaponPosition      0 0 -1                             // X Y Z positions
		weaponPositionAlt   0 2 4
		weaponPositionAlt2  0 4 -2
		
		ejectBrassFunc		"PistolEjectBrass"				// supports "MachineGunEjectBrass" "PistolEjectBrass" and "PanzerFaustEjectBrass"
		
		//modModel 1		""
		
		firstPerson {
			model			"models/weapons/pistols/tt33/v_tt33.md3"
			flashModel		"models/weapons/pistols/tt33/v_tt33_flash.mdc"

			weaponLink
			{
				part 1
				{
					tag		"tag_barrel2"
					model	"models/weapons/pistols/tt33/v_tt33_barrel2.md3"
				}
				part 2
				{
					tag		"tag_barrel3"
					model	"models/weapons/pistols/tt33/v_tt33_barrel3.md3"
				}
				part 3
				{
					tag		"tag_barrel4"
					model	"models/weapons/pistols/tt33/v_tt33_barrel4.md3"
				}
			}
		}
		
		thirdPerson {
			model			"models/weapons/pistols/tt33/tt33_3rd.md3"
			flashmodel		"models/weapons/pistols/tt33/tt33_3rd_flash.md3"
		}
	}
			ammo {
			maxammoPerSkill     400 300 250 200 200 // max ammo capacity per difficulty level (easy,medium,hard,death incarnate,realism)
			maxclipPerSkill     8   8   8   8   8   // max clip capacity per difficulty level (easy,medium,hard,death incarnate,realism)
			uses                1                   // how much ammo will weapon use with one shot
			reloadTime          1600                // reload time in miliseconds
			reloadTimeFull      1600                // reload time in miliseconds
			fireDelayTime       20                  // time between pressing the button and actual shot in miliseconds
			nextShotTime        350                 // time between shots in miliseconds (firing rate)
			nextShotTime2       350                 // alternate time between shots in miliseconds (firing rate)
			maxHeat             0                   // time before weapon will overheat in miliseconds
			coolRate            0                   // time for cooling the weapon in miliseconds
			playerDamage        8                   // damage inflicted by player
			aiDamage            7                   // damage inflicted by AI
			playerSplashRadius  0                   // splash when player is using the weapon (for explosives)
			aiSplashRadius      0                   // splash when AI is using the weapon (for explosives)
			spread              450                 // weapon spread (the higher value - the worse is accuracy)
			aimSpreadScaleAdd   35                  // spread add
			spreadScale         0.3                 // spread scale
			weapRecoilDuration  50                  // recoil intensity
			weapRecoilPitch     0.2 0.1             // recoil values for Pitch
			weapRecoilYaw       0.0 0.0             // recoil values for Yaw
			soundRange          700                 // hearing range for AI
			moveSpeed           0.95                // player's movement speed while holding this weapon
			twoHand             0                   // is weapon twohanded? 1-yes, 0-no
			upAngle             0                  // throw range - works only for grenades and dynamite
			falloffDistance     750.0 1500.0        // falloffDistance min and max
		}
}
